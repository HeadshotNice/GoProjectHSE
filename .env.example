RABBITMQ_EXCHANGE=main_exchange
RABBITMQ_DOCUMENT_SUBMITTED_KEY=document-submitted
RABBITMQ_DOCUMENT_STATUS_KEY=document-status-change
RABBITMQ_DOCUMENT_SUBMITTED_QUEUE=document_submitted
RABBITMQ_DOCUMENT_STATUS_QUEUE=document_status
